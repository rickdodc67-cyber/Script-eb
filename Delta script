    criar("TextLabel", {Size=UDim2.new(1,-64,1,0), BackgroundTransparency=1, Text=texto, TextColor3=Cfg.Cores.Texto, Font=Cfg.Fonte, TextSize=13, TextXAlignment=Enum.TextXAlignment.Left, Parent=row})
