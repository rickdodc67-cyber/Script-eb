--// LÓGICA BASE
function getHumanoid()
    local ch = LocalPlayer.Character
    if not ch then return nil end
    return ch:FindFirstChildOfClass("Humanoid")
end

local function getHRP()
    local ch = LocalPlayer.Character
    if not ch then return nil end
    return ch:FindFirstChild("HumanoidRootPart")
end

local autoJumpConn
function iniciarAutoJump()
    if autoJumpConn then return end
    autoJumpConn = RunService.Heartbeat:Connect(function()
        local hum = getHumanoid()
        if hum and hum.MoveDirection.Magnitude > 0 then
            if hum:GetState() ~= Enum.HumanoidStateType.Jumping then
                hum.Jump = true
            end
        end
    end)
end
function pararAutoJump()
    if autoJumpConn then autoJumpConn:Disconnect(); autoJumpConn = nil end
end

function iniciarJJ()
    task.spawn(function()
        while State.JJEnabled do
            local hum = getHumanoid()
            if hum then
                if State.JJAj and hum.MoveDirection.Magnitude > 0 then hum.Jump = true end
                if State.JJSprint and hum.WalkSpeed < 24 then hum.WalkSpeed = 24 end
            end
            task.wait(math.max(State.JJDelay, State.JJInterval * 0.2))
        end
    end)
end

function aplicarWalkSpeed()
    local hum = getHumanoid()
    if hum and State.WalkSpeedOn then hum.WalkSpeed = State.WalkSpeed end
end
function aplicarJumpPower()
    local hum = getHumanoid()
    if hum and State.JumpPowerOn then
        hum.UseJumpPower = true
        hum.JumpPower = State.JumpPower
    end
end
function aplicarSprint(v)
    local hum = getHumanoid()
    if not hum then return end
    if v and hum.WalkSpeed < 24 then hum.WalkSpeed = 24 end
end

local antiLagCache = {}
function aplicarAntiLag(v)
    if v then
        antiLagCache.brightness = Lighting.Brightness
        antiLagCache.ambient    = Lighting.OutdoorAmbient
        antiLagCache.shadows    = Lighting.GlobalShadows
        antiLagCache.fog        = Lighting.FogEnd
        Lighting.Brightness = 1
        Lighting.OutdoorAmbient = Color3.fromRGB(90,90,90)
        Lighting.GlobalShadows = false
        Lighting.FogEnd = 10000
    else
        if antiLagCache.brightness then Lighting.Brightness = antiLagCache.brightness end
        if antiLagCache.ambient then Lighting.OutdoorAmbient = antiLagCache.ambient end
        if antiLagCache.shadows ~= nil then Lighting.GlobalShadows = antiLagCache.shadows end
        if antiLagCache.fog then Lighting.FogEnd = antiLagCache.fog end
    end
end

local fpsBoostConn
function aplicarFpsBoost(v)
    if v then
        State.ReduceEffects = true; State.ReduceParticles = true
        aplicarReduceEffects(true); aplicarReduceParticles(true)
        if not fpsBoostConn then
            fpsBoostConn = RunService.Heartbeat:Connect(function()
                if not State.FpsBoost then return end
                pcall(function()
                    if settings and settings.Rendering then
                        settings.Rendering.QualityLevel = Enum.QualityLevel.Level01
                    end
                end)
                for _, l in ipairs(Lighting:GetChildren()) do
                    if l:IsA("Light") then l.Shadows = false end
                end
            end)
        end
    else
        State.ReduceEffects = false; State.ReduceParticles = false
        if fpsBoostConn then fpsBoostConn:Disconnect(); fpsBoostConn = nil end
        pcall(function()
            if settings and settings.Rendering then
                settings.Rendering.QualityLevel = Enum.QualityLevel.Automatic
            end
        end)
    end
end

local effectsCache = {}
function aplicarReduceEffects(v)
    if v then
        for _, d in ipairs(Lighting:GetDescendants()) do
            if d:IsA("ParticleEmitter") then
                effectsCache[d] = {Enabled=d.Enabled, Rate=d.Rate}; d.Enabled = false
            elseif d:IsA("Trail") or d:IsA("Beam") or d:IsA("Fire") or d:IsA("Smoke") or d:IsA("Sparkles") then
                effectsCache[d] = {Enabled=d.Enabled}; d.Enabled = false
            end
        end
    else
        for d, c in pairs(effectsCache) do
            if d and d.Parent then
                pcall(function()
                    if c.Enabled ~= nil then d.Enabled = c.Enabled end
                    if c.Rate ~= nil and d:IsA("ParticleEmitter") then d.Rate = c.Rate end
                end)
            end
        end
        effectsCache = {}
    end
end

local particlesCache = {}
function aplicarReduceParticles(v)
    if v then
        for _, d in ipairs(workspace:GetDescendants()) do
            if d:IsA("ParticleEmitter") then
                particlesCache[d] = {Enabled=d.Enabled, Rate=d.Rate}; d.Enabled = false
            end
        end
    else
        for d, c in pairs(particlesCache) do
            if d and d.Parent then
                pcall(function() d.Enabled = c.Enabled; d.Rate = c.Rate end)
            end
        end
        particlesCache = {}
    end
end

function aplicarPerformanceMode(v)
    pcall(function()
        if settings and settings.Rendering then
            settings.Rendering.QualityLevel = v and Enum.QualityLevel.Level01 or Enum.QualityLevel.Automatic
        end
    end)
end

