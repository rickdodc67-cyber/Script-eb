    corner(bg, 12)
    local glow = stroke(bg, estadoInicial and Cfg.Cores.DestaqueGlow or Cfg.Cores.Borda, 1, estadoInicial and 0.3 or 0.7)
    local knob = criar("Frame", {Size=UDim2.fromOffset(18,18), Position=estadoInicial and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9), BackgroundColor3=Color3.new(1,1,1), BorderSizePixel=0, Parent=bg})
    corner(knob, 9)
    local estado = estadoInicial
    local click = criar("TextButton", {Size=UDim2.fromScale(1,1), BackgroundTransparency=1, Text="", Parent=bg})
    click.MouseButton1Click:Connect(function()
        estado = not estado
        tw(bg, 0.18, {BackgroundColor3 = estado and Cfg.Cores.Destaque or Cfg.Cores.Painel3})
        tw(knob, 0.18, {Position = estado and UDim2.new(1,-21,0.5,-9) or UDim2.new(0,3,0.5,-9)})
        glow.Color = estado and Cfg.Cores.DestaqueGlow or Cfg.Cores.Borda
        glow.Transparency = estado and 0.3 or 0.7
        if callback then pcall(callback, estado) end
    end)
    return { row=row }
end

local function slider(parent, texto, minV, maxV, padrao, ordem, callback, sufixo)
    local row = criar("Frame", {Size=UDim2.new(1,0,0,42), BackgroundTransparency=1, LayoutOrder=ordem or 0, Parent=parent})
    criar("TextLabel", {Size=UDim2.new(1,-60,0,16), BackgroundTransparency=1, Text=texto, TextColor3=Cfg.Cores.Texto, Font=Cfg.Fonte, TextSize=12, TextXAlignment=Enum.TextXAlignment.Left, Parent=row})
    local valorTxt = criar("TextLabel", {Size=UDim2.fromOffset(60,16), Position=UDim2.new(1,-60,0,0), BackgroundTransparency=1, Text=tostring(padrao)..(sufixo or ""), TextColor3=Cfg.Cores.DestaqueGlow, Font=Cfg.FonteBold, TextSize=12, TextXAlignment=Enum.TextXAlignment.Right, Parent=row})
    local barBg = criar("Frame", {Size=UDim2.new(1,0,0,6), Position=UDim2.new(0,0,0,26), BackgroundColor3=Cfg.Cores.Fundo, BorderSizePixel=0, Parent=row})
    corner(barBg, 3)
    local barFill = criar("Frame", {Size=UDim2.new((padrao-minV)/(maxV-minV),0,1,0), BackgroundColor3=Cfg.Cores.Destaque, BorderSizePixel=0, Parent=barBg})
    corner(barFill, 3); grad(barFill, Cfg.Cores.Destaque, Cfg.Cores.DestaqueGlow, 0)
    local knob = criar("Frame", {Size=UDim2.fromOffset(14,14), Position=UDim2.new(1,-7,0.5,-7), BackgroundColor3=Color3.new(1,1,1), BorderSizePixel=0, Parent=barFill})
    corner(knob, 7); stroke(knob, Cfg.Cores.Destaque, 2)
    local valor = padrao
    local dragging = false
    local function update(pct)
        pct = math.clamp(pct, 0, 1)
        valor = math.floor(minV + (maxV-minV)*pct + 0.5)
        barFill.Size = UDim2.new(pct, 0, 1, 0)
        valorTxt.Text = tostring(valor)..(sufixo or "")
        if callback then pcall(callback, valor) end
    end
    local hit = criar("TextButton", {Size=UDim2.new(1,0,0,26), Position=UDim2.new(0,0,0,16), BackgroundTransparency=1, Text="", Parent=row})
    local function processar(input)
        local pct = (input.Position.X - barBg.AbsolutePosition.X) / barBg.AbsoluteSize.X
        update(pct)
    end
    hit.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; processar(input)
        end
    end)
    UserInputService.InputChanged:Connect(function(input)
        if dragging and (input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch) then
            processar(input)
        end
    end)
    UserInputService.InputEnded:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = false
        end
    end)
    return { set = update, get = function() return valor end }
end

