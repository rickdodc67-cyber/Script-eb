--// HELPERS
local function criar(cls, props)
    local i = Instance.new(cls)
    for k, v in pairs(props or {}) do i[k] = v end
    return i
end
local function corner(i, r) return criar("UICorner", {CornerRadius=UDim.new(0,r or 8), Parent=i}) end
local function stroke(i, c, t, tr) return criar("UIStroke", {Color=c or Cfg.Cores.Borda, Thickness=t or 1, Transparency=tr or 0, Parent=i}) end
local function grad(i, c1, c2, rot) return criar("UIGradient", {Color=ColorSequence.new(c1,c2), Rotation=rot or 90, Parent=i}) end
local function tw(i, t, p) TweenService:Create(i, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), p):Play() end

local function notificar(txt, tipo)
