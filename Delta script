local function segmentado(parent, texto, opcoes, escolhido, ordem, callback)
    local wrap = criar("Frame", {Size=UDim2.new(1,0,0,54), BackgroundTransparency=1, LayoutOrder=ordem or 0, Parent=parent})
    criar("TextLabel", {Size=UDim2.new(1,0,0,16), BackgroundTransparency=1, Text=texto, TextColor3=Cfg.Cores.Texto, Font=Cfg.Fonte, TextSize=12, TextXAlignment=Enum.TextXAlignment.Left, Parent=wrap})
    local row = criar("Frame", {Size=UDim2.new(1,0,0,30), Position=UDim2.new(0,0,0,20), BackgroundTransparency=1, Parent=wrap})
    criar("UIListLayout", {FillDirection=Enum.FillDirection.Horizontal, Padding=UDim.new(0,6), SortOrder=Enum.SortOrder.LayoutOrder, Parent=row})
    local btns = {}
    for i, op in ipairs(opcoes) do
        local b = criar("TextButton", {Size=UDim2.new(1/#opcoes, -((#opcoes-1)*6)/#opcoes, 1, 0), BackgroundColor3=(op==escolhido) and Cfg.Cores.Destaque2 or Cfg.Cores.Painel3, Text=op, TextColor3=(op==escolhido) and Color3.new(1,1,1) or Cfg.Cores.TextoSec, Font=(op==escolhido) and Cfg.FonteBold or Cfg.Fonte, TextSize=11, AutoButtonColor=false, LayoutOrder=i, Parent=row})
        corner(b, 6)
        b.MouseButton1Click:Connect(function()
            for _, bb in pairs(btns) do
                tw(bb, 0.15, {BackgroundColor3=Cfg.Cores.Painel3}); bb.TextColor3 = Cfg.Cores.TextoSec; bb.Font = Cfg.Fonte
            end
            tw(b, 0.15, {BackgroundColor3=Cfg.Cores.Destaque2}); b.TextColor3 = Color3.new(1,1,1); b.Font = Cfg.FonteBold
            if callback then pcall(callback, op) end
        end)
        btns[op] = b
    end
    return wrap
end

