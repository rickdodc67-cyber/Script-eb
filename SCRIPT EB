--// HELPERS
local function criar(cls, props)
    local i = Instance.new(cls)
    for k, v in pairs(props or {}) do i[k] = v end
    return i
end
local function corner(i, r) return criar("UICorner", {CornerRadius=UDim.new(0,r or 8), Parent=i}) end
local function stroke(i, c, t, tr) return criar("UIStroke", {Color=c or Cfg.Cores.Borda, Thickness=t or 1, Transparency=tr or 0, Parent=i}) end
local function grad(i, c1, c2, rot) return criar("UIGradient", {Color=ColorSequence.new(c1,c2), Rotation=rot or 90, Parent=i}) end
local function tw(i, t, p) TweenService:Create(i, TweenInfo.new(t, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), p):Play() end

local function notificar(txt, tipo)
    if not State.Notifications and tipo ~= "key" then return end
    local sg = CoreGui:FindFirstChild("DeltaHubNotif")
    if not sg then
        sg = criar("ScreenGui", {Name="DeltaHubNotif", ResetOnSpawn=false, IgnoreGuiInset=true, DisplayOrder=100, Parent=CoreGui})
    end
    local corFundo, icone
    if tipo == "erro" then corFundo, icone = Cfg.Cores.Vermelho, "✕ "
    elseif tipo == "aviso" then corFundo, icone = Cfg.Cores.Amarelo, "⚠ "
    else corFundo, icone = Cfg.Cores.Destaque, "✓ " end
    local lbl = criar("TextLabel", {
        Size = UDim2.fromOffset(240, 36),
        Position = UDim2.new(0.5, -120, 0, -60),
        BackgroundColor3 = corFundo,
        Text = icone .. txt,
        TextColor3 = Color3.new(1,1,1),
        Font = Cfg.FonteBold, TextSize = 13,
        TextXAlignment = Enum.TextXAlignment.Center,
        Parent = sg,
    })
    corner(lbl, 9)
    stroke(lbl, Color3.new(1,1,1), 1, 0.85)
    tw(lbl, 0.3, {Position = UDim2.new(0.5, -120, 0, 24)})
    task.delay(2.4, function()
        if lbl and lbl.Parent then
            tw(lbl, 0.3, {Position = UDim2.new(0.5, -120, 0, -60)})
            task.wait(0.35)
            if lbl then lbl:Destroy() end
        end
    end)
end

