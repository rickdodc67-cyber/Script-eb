function LimparTPTool()
    State._tpToolActive = false
    State._tpTool = nil
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if backpack then
        for _, item in ipairs(backpack:GetChildren()) do
            if item:IsA("Tool") and item.Name == "DeltaTPTool" then
                pcall(function() item:Destroy() end)
            end
        end
    end
    local char = LocalPlayer.Character
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and item.Name == "DeltaTPTool" then
                pcall(function() item:Destroy() end)
            end
        end
    end
end

function criarTPTool()
    local backpack = LocalPlayer:FindFirstChildOfClass("Backpack")
    if not backpack then
        notificar("Backpack não encontrado", "erro")
        return nil
    end
    for _, item in ipairs(backpack:GetChildren()) do
        if item:IsA("Tool") and item.Name == "DeltaTPTool" then
            State._tpTool = item; State._tpToolActive = true
            return item
        end
    end
    local char = LocalPlayer.Character
    if char then
        for _, item in ipairs(char:GetChildren()) do
            if item:IsA("Tool") and item.Name == "DeltaTPTool" then
                State._tpTool = item; State._tpToolActive = true
                return item
            end
        end
    end

    local tool = Instance.new("Tool")
    tool.Name = "DeltaTPTool"
    tool.RequiresHandle = true
    tool.CanBeDropped = false
    tool.ToolTip = "Clique/toque no mapa para teleportar"

    local handle = Instance.new("Part")
    handle.Name = "Handle"
    handle.Size = Vector3.new(0.1, 0.1, 0.1)
    handle.Transparency = 1
    handle.CanCollide = false
    handle.Massless = true
    handle.Parent = tool

    tool.Activated:Connect(function()
        if not State._tpToolActive then return end
        if not Camera then return end
        local mouse = LocalPlayer:GetMouse()
        if not mouse then notificar("Destino inválido", "aviso"); return end
        local alvo = mouse.Hit
        if not alvo then notificar("Destino inválido", "aviso"); return end
        local destino = alvo.Position
        if destino.Magnitude > 1e5 or destino.Y ~= destino.Y then
            notificar("Destino inválido", "aviso"); return
        end
        local hrp = getHRP()
        if not hrp then notificar("Personagem não encontrado", "erro"); return end
        hrp.CFrame = CFrame.new(destino + Vector3.new(0, 3, 0))
        notificar("Teleportado!", "ok")
    end)

    tool.Parent = backpack
    State._tpTool = tool
    State._tpToolActive = true
    return tool
end

LocalPlayer.ChildAdded:Connect(function(child)
    if child:IsA("Tool") and child.Name == "DeltaTPTool" then
        State._tpTool = child
    end
end)

function aplicarEstadoCompleto()
    pcall(function()
        aplicarWalkSpeed(); aplicarJumpPower()
        workspace.Gravity = State.GravityOn and State.Gravity or Orig.Gravity
        if Camera then Camera.FieldOfView = State.CameraFovOn and State.CameraFov or Orig.CameraFov end
        aplicarSprint(State.Sprint)
        aplicarAntiLag(State.AntiLag); aplicarFpsBoost(State.FpsBoost)
        aplicarPerformanceMode(State.PerfMode)
        if State.AutoJump or State.ParkourAutoJump then iniciarAutoJump() else pararAutoJump() end
        if State.JJEnabled then iniciarJJ() end
        if State._tpToolActive then criarTPTool() end
    end)
end

--// SISTEMA DE MIRA
local function obterParteAlvo(char, parte)
    if not char then return nil end
    if parte == "Cabeça" then
        return char:FindFirstChild("Head")
    else
        return char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
    end
end

local function obterCentroFov()
    if not Camera then return nil, nil end
    local vp = Camera.ViewportSize
    local centro = Vector2.new(vp.X/2, vp.Y * State.FovPosY)
    local raio = State.FovSize / 2
    return centro, raio
end

local function alvoValido(plr, parteNome, distanciaMax, teamCheck, fovCentro, fovRaio)
    if not plr or plr == LocalPlayer then return nil end
    local char = plr.Character
    if not char then return nil end
    local hum = char:FindFirstChildOfClass("Humanoid")
    if not hum or hum.Health <= 0 then return nil end
    if teamCheck and LocalPlayer.Team and plr.Team == LocalPlayer.Team then return nil end
    local parte = obterParteAlvo(char, parteNome)
    if not parte then return nil end
    local posParte = parte.Position
    local raiz = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart")
    local origem = raiz and raiz.Position or (Camera and Camera.CFrame.Position) or Vector3.zero
    local dist = (posParte - origem).Magnitude
    if dist > distanciaMax then return nil end
    if fovCentro and fovRaio then
        local ponto2D, onScreen = Camera:WorldToViewportPoint(posParte)
        if not onScreen then return nil end
        local dx = ponto2D.X - fovCentro.X
        local dy = ponto2D.Y - fovCentro.Y
        local distTela = math.sqrt(dx*dx + dy*dy)
        if distTela > fovRaio then return nil end
        return {plr=plr, char=char, hum=hum, parte=parte, pos=posParte, dist=dist, distTela=distTela, ponto2D=ponto2D}
    end
    return {plr=plr, char=char, hum=hum, parte=parte, pos=posParte, dist=dist}
end

local function encontrarMelhorAlvo(parteNome, distanciaMax, teamCheck, selecao)
    local centro, raio = obterCentroFov()
    local melhor = nil
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer then
            local dados = alvoValido(plr, parteNome, distanciaMax, teamCheck, centro, raio)
            if dados then
                local criterio = (selecao == "Cruz") and (dados.distTela or 99999) or dados.dist
                if not melhor or criterio < melhor.criterio then
                    melhor = dados
                    melhor.criterio = criterio
                end
            end
        end
    end
    return melhor
end

RunService.RenderStepped:Connect(function(dt)
    if not Camera then return end
    if State.Aimbot then
        local atual = State._currentTarget
        local revalidar = true
        if atual and atual.plr and atual.plr.Parent and atual.char and atual.char.Parent then
            local centro, raio = obterCentroFov()
            local dados = alvoValido(atual.plr, State.TargetPart, State.TargetDistance, State.TeamCheck, centro, raio)
            if dados then
                State._currentTarget = dados
                revalidar = false
            end
        end
        if revalidar then
            if State.TargetLock then
                State._currentTarget = nil
            else
                State._currentTarget = encontrarMelhorAlvo(State.TargetPart, State.TargetDistance, State.TeamCheck, State.TargetSelection)
            end
        end
        local alvo = State._currentTarget
        if alvo and alvo.parte and alvo.parte.Parent then
            local destino = CFrame.new(Camera.CFrame.Position, alvo.parte.Position)
            local smoothing = math.clamp(State.AimSmoothing / 100, 0.01, 1)
            local fator = 1 - math.pow(smoothing, dt * 60)
            fator = math.clamp(fator, 0.02, 1)
            Camera.CFrame = Camera.CFrame:Lerp(destino, fator)
        end
    else
        State._currentTarget = nil
    end
    if State.SilentAim then
        State._silentTarget = encontrarMelhorAlvo(State.SilentTarget, State.SilentDistance, State.SilentTeamCheck, "Cruz")
    else
        State._silentTarget = nil
    end
end)

